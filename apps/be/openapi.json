{
  "openapi": "3.0.0",
  "paths": {
    "/api/health/live": {
      "get": {
        "operationId": "healthLive",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/LivenessDto"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Any failure. `data` is null and `error` says what went wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "summary": "Is the process alive? Wire restart policies here",
        "tags": [
          "health"
        ]
      }
    },
    "/api/health/ready": {
      "get": {
        "operationId": "healthReady",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ReadinessDto"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Any failure. `data` is null and `error` says what went wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "summary": "Can it serve traffic? Wire healthchecks here",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "slop-ai API",
    "description": "Backend for slop-ai, an AI app builder. Every response is an envelope: `{ data }`, or `{ data: null, error }`.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LivenessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string",
            "example": "up"
          },
          "cache": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string",
            "example": "up"
          }
        },
        "required": [
          "database",
          "cache"
        ]
      },
      "ReadinessDto": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string",
            "description": "\"degraded\" means the cache is unreachable; the api still serves requests",
            "example": "ok"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 404
          },
          "message": {
            "type": "string",
            "example": "Resource 42 not found"
          },
          "details": {
            "description": "One entry per failed constraint, on a validation error.",
            "example": [
              "email must be an email"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-04T10:15:30.000Z"
          },
          "path": {
            "type": "string",
            "description": "The request path that failed.",
            "example": "/api/resource/42"
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "example": "ad82cc5c-3eb9-4b5c-8d6f-e3f8c99197b3"
          }
        },
        "required": [
          "statusCode",
          "message",
          "timestamp",
          "path",
          "requestId"
        ]
      },
      "ErrorEnvelopeDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "Always null on the error path."
          },
          "error": {
            "$ref": "#/components/schemas/ApiErrorDto"
          }
        },
        "required": [
          "data",
          "error"
        ]
      }
    }
  }
}
